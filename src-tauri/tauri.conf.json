{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sekund",
  "version": "0.3.9",
  "identifier": "uk.dnpk.sekund",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sekund",
        "fullscreen": true,
        "devtools": true,
        "focus": true,
        "acceptFirstMouse": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3QTY0N0EzNTg1NjM1RjgKUldUNE5WWllvMGVtbDIvV3Q4K1ZHN1E1bm0xOHBkRmlPREMwRnJEQm9aak03QlFISlJldXhDdzIK",
      "endpoints": ["https://github.com/0x5045414b/ClockBeta/releases/latest/download/latest.json"]
    },
    "sql": {
      "preload": ["sqlite:database.sqlite"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "license": "Polyform-Noncommercial-1.0.0",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
