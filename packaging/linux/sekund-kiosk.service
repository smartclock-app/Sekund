# Runs Sekund full screen as the only app on a Raspberry Pi (or any Linux box), with no desktop.
#
# cage is a tiny Wayland compositor that shows one app full screen; Sekund draws through cage's XWayland.
# Install:  sudo apt install cage
#           sudo cp sekund-kiosk.service /etc/systemd/system/
#           sudo systemctl enable --now sekund-kiosk
# See docs/desktop.md for the full set-up, including the "sekund" user this runs as.

[Unit]
Description=Sekund kiosk (cage on tty1)
# Take over the first console instead of a login prompt.
After=systemd-user-sessions.service getty@tty1.service network-online.target
Conflicts=getty@tty1.service
Wants=network-online.target

[Service]
User=sekund
# A real login session on tty1, so cage may use the screen, keyboard and touch input.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# -d: no window decorations. -s: Ctrl+Alt+F2 etc. still switch to a text console.
ExecStart=/usr/bin/cage -d -s -- /opt/sekund/bin/Sekund --kiosk
# Start again after a crash or a Quit from the menu.
Restart=always
RestartSec=5

[Install]
# multi-user, not graphical: Raspberry Pi OS Lite boots to multi-user and has no graphical target to reach.
WantedBy=multi-user.target
